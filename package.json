{
  "name": "covenants-admin-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "pnpm typecheck:client && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint src server shared",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm typecheck:client && pnpm typecheck:server",
    "typecheck:client": "tsc --noEmit -p tsconfig.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:seed:controlled": "node scripts/seed-controlled-substances.mjs",
    "start": "node dist/server/server/index.js"
  },
  "dependencies": {
    "@clerk/react": "^6.7.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@tanstack/react-query": "^5.101.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "lucide-react": "^1.21.0",
    "nodemailer": "^9.0.1",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svix": "^1.96.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.8.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.9"
  }
}
